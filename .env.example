# All variables are optional. `next build` succeeds with none of them set.
# NEXT_PUBLIC_* values are inlined at build time. Set them in Vercel, then redeploy.

# Wallet cluster the UI opens on. The in-app switch can still change it.
# NEXT_PUBLIC_DEFAULT_NETWORK=devnet

# Override the Doju program id after you deploy. Defaults to the committed devnet id.
# NEXT_PUBLIC_DOJU_VAULT_PROGRAM_ID=H1QaDVDzpWcCdHvpGyb7CND7s3NqdP3zVn6ETeAm2yuF

# RPC endpoints. Defaults are the public Solana endpoints.
# NEXT_PUBLIC_SOLANA_RPC_DEVNET=https://api.devnet.solana.com
# NEXT_PUBLIC_SOLANA_RPC_MAINNET=https://api.mainnet-beta.solana.com

# Canonical site URL for SEO. On Vercel, VERCEL_URL is used when this is unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional Plausible analytics. Leave unset to ship with no analytics script.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=vaults.example.com

# Dev-only in-memory wallet. Never enable on a mainnet deployment.
# NEXT_PUBLIC_ENABLE_BURNER=true
